# Test Environment Configuration
# Copy this file to .env.local for testing

# Environment
NODE_ENV=test

# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:4001
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4001/graphql
NEXT_PUBLIC_WS_URL=ws://localhost:4001/graphql
NEXT_PUBLIC_API_TIMEOUT=5000
NEXT_PUBLIC_API_RETRY_ATTEMPTS=1
NEXT_PUBLIC_API_RETRY_DELAY=100

# Authentication Configuration
NEXT_PUBLIC_AUTH_TOKEN_KEY=authToken
NEXT_PUBLIC_AUTH_USER_KEY=authUser
NEXT_PUBLIC_AUTH_REFRESH_TOKEN_KEY=refreshToken
NEXT_PUBLIC_AUTH_AUTO_REFRESH=false
NEXT_PUBLIC_AUTH_REFRESH_THRESHOLD=300

# Feature Flags
NEXT_PUBLIC_ENABLE_WEBSOCKETS=false
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=false
NEXT_PUBLIC_ENABLE_PWA=false
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# UI Configuration
NEXT_PUBLIC_THEME=light
NEXT_PUBLIC_LANGUAGE=en
NEXT_PUBLIC_TIMEZONE=UTC
NEXT_PUBLIC_DATE_FORMAT=MM/DD/YYYY
NEXT_PUBLIC_TIME_FORMAT=HH:mm

# Pagination Configuration
NEXT_PUBLIC_DEFAULT_PAGE_SIZE=5
NEXT_PUBLIC_MAX_PAGE_SIZE=50

# Upload Configuration
NEXT_PUBLIC_MAX_FILE_SIZE=1048576
NEXT_PUBLIC_ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf
NEXT_PUBLIC_IMAGE_COMPRESSION=false
NEXT_PUBLIC_COMPRESSION_QUALITY=0.8 