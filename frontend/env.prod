# Production Environment Configuration
# Copy this file to .env.local for production

# Environment
NODE_ENV=production

# API Configuration
NEXT_PUBLIC_API_BASE_URL=https://your-api-domain.com
NEXT_PUBLIC_GRAPHQL_URL=https://your-api-domain.com/graphql
NEXT_PUBLIC_WS_URL=wss://your-api-domain.com/graphql
NEXT_PUBLIC_API_TIMEOUT=30000
NEXT_PUBLIC_API_RETRY_ATTEMPTS=3
NEXT_PUBLIC_API_RETRY_DELAY=1000

# Authentication Configuration
NEXT_PUBLIC_AUTH_TOKEN_KEY=authToken
NEXT_PUBLIC_AUTH_USER_KEY=authUser
NEXT_PUBLIC_AUTH_REFRESH_TOKEN_KEY=refreshToken
NEXT_PUBLIC_AUTH_AUTO_REFRESH=true
NEXT_PUBLIC_AUTH_REFRESH_THRESHOLD=300

# Feature Flags
NEXT_PUBLIC_ENABLE_WEBSOCKETS=true
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=false
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# UI Configuration
NEXT_PUBLIC_THEME=light
NEXT_PUBLIC_LANGUAGE=en
NEXT_PUBLIC_TIMEZONE=UTC
NEXT_PUBLIC_DATE_FORMAT=MM/DD/YYYY
NEXT_PUBLIC_TIME_FORMAT=HH:mm

# Pagination Configuration
NEXT_PUBLIC_DEFAULT_PAGE_SIZE=10
NEXT_PUBLIC_MAX_PAGE_SIZE=100

# Upload Configuration
NEXT_PUBLIC_MAX_FILE_SIZE=5242880
NEXT_PUBLIC_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
NEXT_PUBLIC_IMAGE_COMPRESSION=true
NEXT_PUBLIC_COMPRESSION_QUALITY=0.8 