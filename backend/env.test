# Test Environment Configuration
# Copy this file to .env for testing

# Environment
NODE_ENV=test

# Server Configuration
PORT=4001
HOST=localhost
FRONTEND_URL=http://localhost:3001
GRAPHQL_PATH=/graphql

# Database Configuration
# Options: memory, cache, mongodb, postgresql
DB_TYPE=memory

# MongoDB Configuration (when DB_TYPE=mongodb)
# MONGODB_URL=mongodb://localhost:27017/event-manager-test

# PostgreSQL Configuration (when DB_TYPE=postgresql)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=event_manager_test
# DB_USER=postgres
# DB_PASSWORD=

# Cache Configuration (when DB_TYPE=cache)
# CACHE_HOST=localhost
# CACHE_PORT=6379
# CACHE_PASSWORD=
# CACHE_TTL=3600

# Memory Cache Configuration (when DB_TYPE=memory)
MEMORY_CACHE_SIZE=100

# Redis Cache Configuration
CACHE_TYPE=memory
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TTL=3600
MEMORY_CACHE_TTL=300

# Authentication Configuration
JWT_SECRET=test-jwt-secret-key
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=4
REFRESH_TOKEN_EXPIRES_IN=2h

# Logging Configuration
LOG_LEVEL=error
LOG_FORMAT=simple
LOG_CONSOLE=false
LOG_FILE=false
LOG_FILE_PATH=./logs/test.log 