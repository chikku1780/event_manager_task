# Production Environment Configuration
# Copy this file to .env for production

# Environment
NODE_ENV=production

# Server Configuration
PORT=4000
HOST=0.0.0.0
FRONTEND_URL=https://your-frontend-domain.com
GRAPHQL_PATH=/graphql

# Database Configuration
# Options: memory, cache, mongodb, postgresql
DB_TYPE=mongodb

# MongoDB Configuration (when DB_TYPE=mongodb)
MONGODB_URL=mongodb://your-production-mongodb-url:27017/event-manager

# PostgreSQL Configuration (when DB_TYPE=postgresql)
# DB_HOST=your-production-postgres-host
# DB_PORT=5432
# DB_NAME=event_manager
# DB_USER=your_db_user
# DB_PASSWORD=your_secure_password

# Cache Configuration (when DB_TYPE=cache)
# CACHE_HOST=your-redis-host
# CACHE_PORT=6379
# CACHE_PASSWORD=your_redis_password
# CACHE_TTL=3600

# Memory Cache Configuration (when DB_TYPE=memory)
MEMORY_CACHE_SIZE=1000

# Redis Cache Configuration
CACHE_TYPE=redis
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_TTL=3600
MEMORY_CACHE_TTL=3600

# Authentication Configuration
JWT_SECRET=your-super-secure-production-jwt-secret-key
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12
REFRESH_TOKEN_EXPIRES_IN=7d

# Logging Configuration
LOG_LEVEL=warn
LOG_FORMAT=json
LOG_CONSOLE=true
LOG_FILE=true
LOG_FILE_PATH=./logs/app.log 