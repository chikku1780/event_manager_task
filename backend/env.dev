# Development Environment Configuration
# Copy this file to .env for development

# Environment
NODE_ENV=development

# Server Configuration
PORT=4000
HOST=localhost
FRONTEND_URL=http://localhost:3000
GRAPHQL_PATH=/graphql

# Database Configuration
# Options: memory, cache, mongodb, postgresql
DB_TYPE=memory

# MongoDB Configuration (when DB_TYPE=mongodb)
# MONGODB_URL=mongodb://localhost:27017/event-manager

# PostgreSQL Configuration (when DB_TYPE=postgresql)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=event_manager
# DB_USER=postgres
# DB_PASSWORD=

# Cache Configuration (when DB_TYPE=cache)
# CACHE_HOST=localhost
# CACHE_PORT=6379
# CACHE_PASSWORD=
# CACHE_TTL=3600

# Memory Cache Configuration (when DB_TYPE=memory)
MEMORY_CACHE_SIZE=1000

# Redis Cache Configuration
CACHE_TYPE=memory
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TTL=3600
MEMORY_CACHE_TTL=3600

# Authentication Configuration
JWT_SECRET=dev-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12
REFRESH_TOKEN_EXPIRES_IN=7d

# Logging Configuration
LOG_LEVEL=debug
LOG_FORMAT=simple
LOG_CONSOLE=true
LOG_FILE=false
LOG_FILE_PATH=./logs/app.log 